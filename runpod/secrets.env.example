# Copy this file to secrets.env, fill in real values, then upload secrets.env
# to the pod (paste into `nano secrets.env` over SSH, or scp it in).
# NEVER commit secrets.env — it's gitignored, keep it that way.
#
# On a persistent RunPod Network Volume this is a ONE-TIME upload: it survives
# pod stop/restart on the same volume, so you only do this once per volume,
# not once per pod. See docs/runpod_setup.md.
#
# Base64 here is just encoding — fitting a multi-line JSON key onto one
# env-file line — not encryption. Treat this value with the same care as the
# raw key file.

# GCP service-account key for DVC/GCS access, base64-encoded, single line.
# One-time creation steps: docs/runpod_setup.md
GCP_SA_KEY_B64=

# Only needed if you'll push commits or use the `gh` CLI from the pod —
# clone/pull works without it since the repo is public. Use a fine-grained
# PAT scoped to just this repo, with a short expiry.
GITHUB_TOKEN=
